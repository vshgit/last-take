config_version=5

[application]
config/name="Last Take"
config/version="1.0.0"
boot_splash/show_image=false
boot_splash/bg_color=Color(0,0,0,1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/description="Киноиспытание. Windows-прототип."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.015,0.02,0.023,1)

[audio]
driver/enable_input=false
